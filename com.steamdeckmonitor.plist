<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.steamdeckmonitor</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <!-- NOTE: Update path below to match your installation -->
        <string>$HOME/Programs/steamDeckNotifier/STEAM_DECK_NOTIFICATION.py</string>
    </array>
    <key>StartInterval</key>
    <integer>900</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>$HOME/Programs/steamDeckNotifier/Logs/steam_deck.log</string>
    <key>StandardErrorPath</key>
    <string>$HOME/Programs/steamDeckNotifier/Logs/steam_deck_err.log</string>
</dict>
</plist>
